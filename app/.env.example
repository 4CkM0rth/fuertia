# Copia este archivo como .env (no se sube al repositorio) y ajusta la dirección del backend.
# En el emulador de Android o en el simulador sirve localhost (en el emulador también 10.0.2.2).
# En un celular físico pon la IP de tu computador en la red wifi, por ejemplo:
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8080
EXPO_PUBLIC_API_URL=http://localhost:8080
