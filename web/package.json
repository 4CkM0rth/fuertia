{
  "name": "@fuertia/web",
  "private": true,
  "version": "0.1.0",
  "description": "Panel web del entrenador de Fuertia.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
